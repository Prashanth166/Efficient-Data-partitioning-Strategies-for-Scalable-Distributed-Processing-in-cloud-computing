# Copy this file to .env and change all secret values.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
# Local development works with SQLite by default. For MySQL, uncomment and edit:
# DATABASE_URL=mysql+pymysql://partition_user:YOUR_PASSWORD@127.0.0.1/partitioning_db?charset=utf8mb4

# Create an admin account on the first run by setting both values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Chotu@166

# Optional: generate a key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key stable and secret; losing it means stored data cannot be decrypted.
# ENCRYPTION_KEY=put-generated-fernet-key-here
DATABASE_URL=mysql+pymysql://partition_user:ChooseAStrongPassword@127.0.0.1/partitioning_db?charset=utf8mb4
FLASK_DEBUG=1
